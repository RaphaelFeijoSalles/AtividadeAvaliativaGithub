programa {
  funcao inicio() {
    inteiro numA, numB, resul
    escreva("********Subtração********\nInsira o minuendo: ")
    leia(numA)
    escreva("Insira o subtraendo: ")
    leia(numB)
    resul = (numA - numB)
    escreva("a subtração dos numeros é ", resul)
  }
}

